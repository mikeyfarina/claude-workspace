#!/usr/bin/env bash
# paneful — put your terminal back exactly as you left it, agents and all.
#
# Snapshots the window/tab/split layout of a terminal together with the coding
# agent session running in each pane, then brings all of it back after a quit,
# a reboot or a crash. See `paneful help`.
# No `set -e`: this program is full of `[ cond ] && action` statements, and a
# false condition at the wrong place would abort a restore halfway through.
# Every call whose failure matters is checked explicitly instead.
set -uo pipefail

# Resolve this script through any symlinks so lib/ is found whether the tool is
# run from a clone, a ~/.local/bin symlink or a Homebrew install.
_cw_self=${BASH_SOURCE[0]}
while [ -L "$_cw_self" ]; do
    _cw_dir=$(cd -P "$(dirname "$_cw_self")" && pwd)
    _cw_self=$(readlink "$_cw_self")
    case $_cw_self in /*) ;; *) _cw_self=$_cw_dir/$_cw_self ;; esac
done
PANEFUL_BIN_DIR=$(cd -P "$(dirname "$_cw_self")" && pwd)
PANEFUL_ROOT=$(cd -P "$PANEFUL_BIN_DIR/.." && pwd)
unset _cw_self _cw_dir

# Homebrew installs the payload under libexec; a clone keeps it alongside bin/.
if [ -d "$PANEFUL_ROOT/lib/terminals" ]; then
    PANEFUL_LIB=$PANEFUL_ROOT/lib
    PANEFUL_SHELL_DIR=$PANEFUL_ROOT/shell
elif [ -d "$PANEFUL_ROOT/libexec/lib/terminals" ]; then
    PANEFUL_LIB=$PANEFUL_ROOT/libexec/lib
    PANEFUL_SHELL_DIR=$PANEFUL_ROOT/libexec/shell
else
    printf 'paneful: cannot find lib/ next to %s\n' "$PANEFUL_BIN_DIR" >&2
    exit 1
fi
export PANEFUL_ROOT PANEFUL_LIB PANEFUL_SHELL_DIR

# shellcheck source=../lib/common.sh
. "$PANEFUL_LIB/common.sh"

cmd=${1:-help}
[ $# -gt 0 ] && shift

case $cmd in
    save)
        load snapshot terminal providers
        cmd_save "$@" ;;
    restore)
        load snapshot restore terminal providers
        cmd_restore "$@" ;;
    simulate|plan)
        load snapshot restore terminal providers
        cmd_simulate "$@" ;;
    diff)
        load snapshot restore terminal providers
        cmd_diff "$@" ;;
    status)
        load snapshot terminal providers
        cmd_status "$@" ;;
    list|snapshots)
        load snapshot
        cmd_list "$@" ;;
    history)
        load snapshot
        cmd_history "$@" ;;
    log)
        cmd_log "$@" ;;
    dismiss)
        load snapshot terminal
        cmd_dismiss "$@" ;;
    map)
        load snapshot terminal
        cmd_map "$@" ;;
    first-prompt)
        load snapshot restore terminal providers
        cmd_first_prompt "$@" ;;
    register-self)
        load snapshot terminal
        cmd_register_self "$@" ;;
    unplaced)
        load snapshot restore terminal providers
        cmd_unplaced "$@" ;;
    hook)
        cmd_hook "$@" ;;
    doctor)
        load snapshot setup terminal providers
        cmd_doctor "$@" ;;
    install)
        load setup terminal providers
        cmd_install "$@" ;;
    uninstall)
        load setup
        cmd_uninstall "$@" ;;
    shell-init)
        load setup
        cmd_shell_init "$@" ;;
    providers)
        load providers
        cmd_providers "$@" ;;
    terminals)
        load terminal
        cmd_terminals "$@" ;;
    version|--version|-v)
        printf 'paneful %s\n' "$PANEFUL_VERSION" ;;
    help|--help|-h)
        cmd_help "$@" ;;
    *)
        die "unknown command: $cmd (try: paneful help)" ;;
esac
